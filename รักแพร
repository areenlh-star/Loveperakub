    <script>
        /* === Background Floating Hearts Generator === */
        function createBackgroundHearts() {
            const container = document.getElementById('bg-hearts-container');
            const heartIcons = ['❤️', '💖', '💗', '💓', '🌸', '✨'];
            const count = 18;

            for (let i = 0; i < count; i++) {
                const heart = document.createElement('div');
                heart.className = 'bg-heart text-2xl';
                heart.innerText = heartIcons[Math.floor(Math.random() * heartIcons.length)];
                
                // Random position and timing
                heart.style.left = `${Math.random() * 100}vw`;
                heart.style.animationDuration = `${6 + Math.random() * 6}s`;
                heart.style.animationDelay = `${Math.random() * 5}s`;
                heart.style.fontSize = `${16 + Math.random() * 24}px`;

                container.appendChild(heart);
            }
        }

        /* === Interactive Click/Tap Floating Heart Effect === */
        document.addEventListener('click', function(e) {
            // Ignore click if it's on music or reveal button to prevent clutter
            if (e.target.closest('button')) return;

            spawnHeartAt(e.clientX, e.clientY);
        });

        function spawnHeartAt(x, y) {
            const emojis = ['💖', '💕', '❤️', '🌸', '✨', '💗'];
            const heart = document.createElement('div');
            heart.className = 'click-heart text-3xl';
            heart.innerText = emojis[Math.floor(Math.random() * emojis.length)];
            heart.style.left = `${x}px`;
            heart.style.top = `${y}px`;

            document.body.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 1000);
        }

        /* === Heart Burst & Confetti === */
        function createBurst(e) {
            const rect = e.target.getBoundingClientRect();
            const x = (rect.left + rect.width / 2) / window.innerWidth;
            const y = (rect.top + rect.height / 2) / window.innerHeight;

            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 40,
                    spread: 60,
                    origin: { x: x, y: y },
                    colors: ['#ff758f', '#ff70a6', '#ff97b7', '#ffccd5']
                });
            }

            playSweetTone(523.25, 0.2); // Play high C note on click
        }

        /* === Secret Message Reveal Function === */
        let isRevealed = false;
        function revealSecret() {
            const secretBox = document.getElementById('secret-box');
            
            if (!isRevealed) {
                secretBox.classList.remove('hidden');
                setTimeout(() => {
                    secretBox.classList.remove('opacity-0');
                    secretBox.classList.add('opacity-100');
                }, 50);

                // Celebrate with Confetti
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 80,
                        spread: 80,
                        origin: { y: 0.6 },
                        colors: ['#ff4d6d', '#ff758f', '#ffb3c1', '#fff0f3']
                    });
                }
                playChimeSound();
                isRevealed = true;
            } else {
                // Heart burst again if already clicked
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 30,
                        spread: 50,
                        origin: { y: 0.7 }
                    });
                }
            }
        }

        /* === Web Audio API for Soft Musical Background Tone === */
        let audioCtx = null;
        let isPlaying = false;
        let melodyInterval = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playSweetTone(freq, duration) {
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.log("Audio play error:", e);
            }
        }

        function playChimeSound() {
            const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
            notes.forEach((note, index) => {
                setTimeout(() => {
                    playSweetTone(note, 0.4);
                }, index * 120);
            });
        }

        function toggleAudio() {
            initAudio();
            const musicText = document.getElementById('music-text');

            if (!isPlaying) {
                isPlaying = true;
                musicText.innerText = "ปิดเพลง 🎵";
                
                // Simple soft ambient melody loop
                const melodyNotes = [261.63, 329.63, 392.00, 329.63, 349.23, 440.00, 392.00, 329.63];
                let noteIndex = 0;

                melodyInterval = setInterval(() => {
                    playSweetTone(melodyNotes[noteIndex], 1.2);
                    noteIndex = (noteIndex + 1) % melodyNotes.length;
                }, 800);

            } else {
                isPlaying = false;
                musicText.innerText = "เปิดเพลง ✨";
                if (melodyInterval) clearInterval(melodyInterval);
            }
        }

        // Initialize background animations on window load
        window.onload = function() {
            createBackgroundHearts();
        };
    </script>
</body>
</html>
