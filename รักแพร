        /* Floating background hearts animation */
        @keyframes floatUp {
            0% {
                transform: translateY(100vh) scale(0.5) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(-20vh) scale(1.2) rotate(360deg);
                opacity: 0;
            }
        }

        .bg-heart {
            position: absolute;
            color: rgba(255, 117, 143, 0.4);
            animation: floatUp 8s linear infinite;
            pointer-events: none;
            z-index: 0;
        }

        /* Glow effects */
        .text-glow {
            text-shadow: 0 0 15px rgba(255, 105, 180, 0.6), 0 0 30px rgba(255, 182, 193, 0.8);
        }

        .card-glow {
            box-shadow: 0 10px 30px -5px rgba(255, 105, 180, 0.3),
                        0 0 15px 0 rgba(255, 182, 193, 0.4);
        }

        /* Heart Pulse Animation */
        @keyframes pulseGlow {
            0%, 100% {
                transform: scale(1);
                filter: drop-shadow(0 0 10px rgba(255, 99, 132, 0.6));
            }
            50% {
                transform: scale(1.08);
                filter: drop-shadow(0 0 25px rgba(255, 99, 132, 0.9));
            }
